{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "voxura-launcher",
  "version": "1.1.0",
  "identifier": "voxura-launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "splashscreen",
        "title": "Chargement...",
        "width": 400,
        "height": 300,
        "resizable": false,
        "center": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true
      },
      {
        "label": "main",
        "title": "Voxura Launcher",
        "width": 900,
        "height": 650,
        "minWidth": 820,
        "minHeight": 580,
        "resizable": false,
        "maximizable": false,
        "center": true,
        "decorations": true,
        "visible": false
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      },
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
